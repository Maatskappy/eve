# Optional. Comma-separated GitHub organizations or users whose repositories the
# `git__gh` tool may access. Leave empty to run without `git__gh`; the GitHub
# channel still works.
GITHUB_ORGS=

# Optional. Vercel Connect GitHub connector UID. Default: github/coding-agent.
GITHUB_CONNECTOR=

# Optional. Comment invocation token, usually your GitHub App's slug.
# Default: coding-agent.
GITHUB_BOT_NAME=
